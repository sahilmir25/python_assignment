def checkArmstrong(num):
    original = num
    total = 0
    digits = len(str(num))

    while num > 0:
        digit = num % 10
        total = total + digit ** digits
        num = num // 10

    if total == original:
        return True
    else:
        return False


n = int(input("Enter a number: "))

if checkArmstrong(n):
    print("Armstrong number")
else:
    print("Not an Armstrong number")
