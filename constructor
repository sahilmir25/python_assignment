import math

# i) Shape class
class Shape:
    def __init__(self, sides):
        self.sides = sides


# ii) Triangle class
class Triangle(Shape):
    def __init__(self, side1, side2, side3, angles):
        super().__init__(3)
        self.side1 = side1
        self.side2 = side2
        self.side3 = side3
        self.angles = angles


# iii) Equilateral Triangle
class EquilateralTriangle(Triangle):
    def __init__(self, side, colour):
        super().__init__(side, side, side, 60)
        self.colour = colour

    def calculate(self):
        area = (math.sqrt(3) / 4) * self.side1 ** 2
        return area


# iv) Sequence child of Triangle
class Sequence(Triangle):
    def perimeter(self):
        return self.side1 + self.side2 + self.side3

    def calculate(self):
        s = (self.side1 + self.side2 + self.side3) / 2
        area = math.sqrt(
            s * (s - self.side1) *
            (s - self.side2) *
            (s - self.side3)
        )
        return area


# Equilateral Triangle object
t1 = EquilateralTriangle(6, "Red")

print("Equilateral Triangle")
print("Colour:", t1.colour)
print("Area:", t1.calculate())


# Sequence object
t2 = Sequence(3, 4, 5, [60, 60, 60])

print("\nTriangle")
print("Perimeter:", t2.perimeter())
print("Area:", t2.calculate())
