class Student:

    def __init__(self, name, dept, roll):
        self.name = name
        self.dept = dept
        self.roll = roll

    def show(self):
        print("Name:", self.name)
        print("Department:", self.dept)
        print("Roll:", self.roll)
        print()


# Five student objects
s1 = Student("Amit", "CSE", 101)
s2 = Student("Rahul", "CSE", 102)
s3 = Student("Priya", "IT", 103)
s4 = Student("Riya", "ECE", 104)
s5 = Student("Suman", "CSE", 105)


# Show records
s1.show()
s2.show()
s3.show()
s4.show()
s5.show()
