import numpy as np

A = np.array([
    [1, 2, 3],
    [0, 1, 4],
    [5, 6, 0]
])

B = np.array([
    [2, 1, 3],
    [1, 0, 2],
    [4, 1, 1]
])

print("Matrix A:")
print(A)

print("\nMatrix B:")
print(B)

# i) Inverse of A
print("\nInverse of A:")
print(np.linalg.inv(A))

# ii) Determinant of B
print("\nDeterminant of B:")
print(np.linalg.det(B))

# iii) A . B^-1
print("\nA . B^-1:")
print(A @ np.linalg.inv(B))
