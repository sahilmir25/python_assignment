import numpy as np
from scipy.linalg import lu

A = np.array([
    [4, 1, 2, 0],
    [1, 3, 0, 1],
    [2, 0, 5, 1],
    [0, 1, 1, 2]
])

print("Matrix A:")
print(A)

# Eigenvalues and eigenvectors
eigenvalues, eigenvectors = np.linalg.eig(A)

print("\nEigenvalues:")
print(eigenvalues)

print("\nEigenvectors:")
print(eigenvectors)

# PLU decomposition
P, L, U = lu(A)

print("\nP:")
print(P)

print("\nL:")
print(L)

print("\nU:")
print(U)
